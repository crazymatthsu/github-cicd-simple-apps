# CODEOWNERS (ADR-0005, ADR-0020). Branch protection on main requires a CODEOWNER review.
#
# Demo: @crazymatthsu stands in for every team. The comment above each rule names the team that owns
# the path in the enterprise (organisation placeholder: @example). The LAST matching pattern wins, so
# the general rules come first and the per-flow config rules last. The promoted envs (qa, uat, prod, parallel)
# are configured, approved and deployed in the configuration repository, never here (ADR-0004).

# Everything else — the connector apps and the framework they are built on: connectors team (@example/connectors-team)
*                       @crazymatthsu
/apps/                  @crazymatthsu
/framework/             @crazymatthsu

# Build platform: convention plugins, wrapper, version catalog, root build, manifest — platform team
# (@example/platform-team). Shared tooling, whose source is this repository (ADR-0005).
/build-logic/           @crazymatthsu
/gradle/                @crazymatthsu
/gradlew                @crazymatthsu
/gradlew.bat            @crazymatthsu
/settings.gradle.kts    @crazymatthsu
/build.gradle.kts       @crazymatthsu
/gradle.properties      @crazymatthsu
/platform.yml           @crazymatthsu

# CI/CD: workflows, composite actions, affected map, CI and runtime scripts, release tooling — platform team
# (@example/platform-team)
/.github/               @crazymatthsu
/scripts/               @crazymatthsu
/release-please-config.json     @crazymatthsu
/.release-please-manifest.json  @crazymatthsu
/renovate.json          @crazymatthsu
/.hadolint.yaml         @crazymatthsu

# The CA bundle of the test stacks — platform team + security (@example/platform-team @example/security)
/test-infra/ca/         @crazymatthsu

# Test infrastructure — platform team with the connectors team (@example/platform-team @example/connectors-team)
/test-infra/            @crazymatthsu

# Config tree (ADR-0011): local and the dev envs of platform.yml — connectors team (@example/connectors-team)
/config/                @crazymatthsu

# Each flow owns its directory in every env, including its deploy inventory and host pool
# config/<env>/<flow>/workflows-config.yml (ADR-0027, ADR-0028) — flow teams (@example/flow-cash @example/flow-deriv @example/flow-swap)
/config/*/cash/         @crazymatthsu
/config/*/deriv/        @crazymatthsu
/config/*/swap/         @crazymatthsu
