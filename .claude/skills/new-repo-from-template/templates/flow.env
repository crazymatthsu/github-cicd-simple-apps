# Compose env, flow layer of __ENV__/__FLOW__ (ADR-0012): what every app and instance of the cluster shares (ADR-0011).
# Merged first: _docker-compose.app.env, then <AppInstance>/_docker-compose.instance.env override it per key
# (run-compose.sh writes the combined env, .run/<env>/<flow>/<AppName>/<AppInstance>/compose.env). Deploy-time
# knobs only: never a Spring property, never a secret (secrets pass through from the shell, ADR-0013).
IMAGE_REPO=__REGISTRY__/__PROJECT__
TZ=UTC
LOG_LEVEL_ROOT=INFO
# Dev envs only (ADR-0018): the flow's logs and data on its boxes, /logs/<pool user>/<project>/{logs,data}; each
# instance mounts its own <dir>/<AppName>/<AppInstance> at /app/logs and /app/data.
#LOGS_DIR=/logs/deploy/__PROJECT__/logs
#DATA_DIR=/logs/deploy/__PROJECT__/data
