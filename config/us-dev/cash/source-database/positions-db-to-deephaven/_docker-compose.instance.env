# Compose env, instance layer of us-dev/cash/source-database/positions-db-to-deephaven (ADR-0012):
# the image tag, the identity and the actuator port — only this layer sets them. Overrides _docker-compose.app.env
# and _docker-compose.flow.env per key. IMAGE_TAG declares the intent (ADR-0027): `main` in *-dev envs — deploy-dev
# pins the literal version in the GitHub Deployment record, record-tag in the box's version directory, never in
# git — `local` locally. Never a Spring property, never a secret (ADR-0013).
IMAGE_TAG=main
APP_ENV=us-dev
APP_FLOW=cash
APP_NAME=source-database
APP_INSTANCE=positions-db-to-deephaven
ACTUATOR_HOST_PORT=18082
