# Layer 7 — compose variables of us-dev/cash/source-database/trades-db-to-amps (D5 §6.3): deploy-time knobs only, never a Spring property
# and never a secret (secrets pass through from the shell, D2 §8.1). IMAGE_TAG declares the intent (DL-40): `main`
# in *-dev envs — deploy-dev pins the literal version in the GitHub Deployment record, never in git — `local` locally.
IMAGE_REPO=ghcr.io/crazymatthsu/github-cicd-simple-apps
IMAGE_TAG=main
APP_ENV=us-dev
APP_FLOW=cash
APP_NAME=source-database
APP_INSTANCE=trades-db-to-amps
JAVA_OPTS=-XX:MaxRAMPercentage=75
TZ=America/New_York
LOG_LEVEL_ROOT=INFO
ACTUATOR_HOST_PORT=18081
MEM_LIMIT=1g
