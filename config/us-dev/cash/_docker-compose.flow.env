# Compose env, flow layer of us-dev/cash (ADR-0012): what every app and instance of the cluster shares (ADR-0011).
# Merged first: _docker-compose.app.env, then <AppInstance>/_docker-compose.instance.env override it per key
# (run-compose.sh writes the combined env, .run/<env>/<flow>/<AppName>/<AppInstance>/compose.env). Deploy-time
# knobs only: never a Spring property, never a secret (secrets pass through from the shell, ADR-0013).
IMAGE_REPO=ghcr.io/crazymatthsu/github-cicd-simple-apps
TZ=America/New_York
LOG_LEVEL_ROOT=INFO
# The flow's logs and data on its boxes, /logs/<user>/<project>/{logs,data} (ADR-0018; pool.user `deploy`, the project of
# platform.yml): each instance mounts its own <dir>/<AppName>/<AppInstance> at /app/logs and /app/data.
LOGS_DIR=/logs/deploy/github-cicd-simple-apps/logs
DATA_DIR=/logs/deploy/github-cicd-simple-apps/data
