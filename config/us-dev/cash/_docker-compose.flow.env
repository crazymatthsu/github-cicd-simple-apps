# Compose env, flow layer of us-dev/cash (R-0008): what every app and instance of the cluster shares (DL-44).
# Merged first: _docker-compose.app.env, then <AppInstance>/_docker-compose.instance.env override it per key
# (run-compose.sh writes the combined env, .run/<env>/<flow>/<AppName>/<AppInstance>/compose.env). Deploy-time
# knobs only: never a Spring property, never a secret (secrets pass through from the shell, D2 §8.1).
IMAGE_REPO=ghcr.io/crazymatthsu/github-cicd-simple-apps
TZ=America/New_York
LOG_LEVEL_ROOT=INFO
