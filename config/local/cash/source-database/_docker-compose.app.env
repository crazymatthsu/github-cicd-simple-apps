# Compose env, app layer of local/cash/source-database (ADR-0012): what every instance of the app shares in this flow.
# Overrides _docker-compose.flow.env per key; <AppInstance>/_docker-compose.instance.env overrides it. Deploy-time
# knobs only: never a Spring property, never a secret (ADR-0012, ADR-0013).
JAVA_OPTS=-XX:MaxRAMPercentage=60
MEM_LIMIT=768m
