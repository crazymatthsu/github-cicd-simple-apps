# Compose env, app layer of local/cash/source-kafka (R-0008): what every instance of the app shares in this flow.
# Overrides _docker-compose.flow.env per key; <AppInstance>/_docker-compose.instance.env overrides it. Deploy-time
# knobs only: never a Spring property, never a secret (D5 §6.3, D2 §8.1).
JAVA_OPTS=-XX:MaxRAMPercentage=60
MEM_LIMIT=768m
