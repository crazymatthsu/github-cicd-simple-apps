# Compose env, instance layer of local/cash/source-kafka/bbg-equity-ticks (R-0008, D5 §6.3):
# the image tag, the identity and the actuator port — only this layer sets them. Overrides _docker-compose.app.env
# and _docker-compose.flow.env per key. IMAGE_TAG declares the intent (DL-40): `main` in *-dev envs — deploy-dev
# pins the literal version in the GitHub Deployment record, record-tag in the box's version directory, never in
# git — `local` locally. Never a Spring property, never a secret (D2 §8.1).
IMAGE_TAG=local
APP_ENV=local
APP_FLOW=cash
APP_NAME=source-kafka
APP_INSTANCE=bbg-equity-ticks
ACTUATOR_HOST_PORT=18083
