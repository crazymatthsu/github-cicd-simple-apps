# Layer 7 — compose variables of local/cash/source-kafka/bbg-equity-ticks (D5 §6.3): deploy-time knobs only, never a Spring property
# and never a secret (secrets pass through from the shell, D2 §8.1). IMAGE_TAG declares the intent (DL-40): `main`
# in *-dev envs — deploy-dev pins the literal version in the GitHub Deployment record, never in git — `local` locally.
IMAGE_REPO=ghcr.io/crazymatthsu/github-cicd-simple-apps
IMAGE_TAG=local
APP_ENV=local
APP_FLOW=cash
APP_NAME=source-kafka
APP_INSTANCE=bbg-equity-ticks
JAVA_OPTS=-XX:MaxRAMPercentage=60
TZ=UTC
LOG_LEVEL_ROOT=INFO
ACTUATOR_HOST_PORT=18083
MEM_LIMIT=768m
